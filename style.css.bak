:root{
  --bg1:#fff7d6;--bg2:#e8f7ff;--paper:#ffffff;--ink:#20243a;--muted:#667085;
  --purple:#6c4df6;--pink:#ff4f8b;--yellow:#ffc83d;--cyan:#35c6df;--green:#38b96e;--red:#e94f55;
  --track:#4b4f5c;--track-edge:#30333d;--lane:#ffffff;--shadow:0 18px 55px rgba(56,46,110,.14);
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--ink);min-height:100vh;background:
radial-gradient(circle at 8% 10%,rgba(255,200,61,.34),transparent 24%),radial-gradient(circle at 90% 5%,rgba(108,77,246,.16),transparent 25%),linear-gradient(145deg,var(--bg1),var(--bg2))}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.26;background-image:radial-gradient(#6c4df6 1.1px,transparent 1.1px);background-size:24px 24px;mask-image:linear-gradient(to bottom,black,transparent 65%)}
.container{width:min(1000px,92vw);margin:0 auto;padding:28px 0 48px;position:relative}.container.wide{width:min(1320px,94vw)}
.brand,.race-hero{display:flex;align-items:flex-start;justify-content:space-between;gap:22px;margin-bottom:20px}.brand h1,.race-hero h1{font-size:clamp(30px,4.8vw,58px);margin:3px 0 0;line-height:1.02;letter-spacing:-.035em}.race-hero h1{max-width:900px}
.eyebrow,.stage-kicker{font-size:12px;font-weight:900;letter-spacing:.13em;color:var(--purple);text-transform:uppercase}.badge,.live-panel{font-size:13px;border:1px solid rgba(108,77,246,.18);border-radius:999px;padding:9px 13px;background:rgba(255,255,255,.76);box-shadow:0 8px 24px rgba(75,65,110,.08);white-space:nowrap}.live-panel{display:flex;align-items:center;gap:8px}.live-dot{width:10px;height:10px;border-radius:50%;background:var(--green);box-shadow:0 0 0 6px rgba(56,185,110,.12);animation:pulse 1.7s infinite}@keyframes pulse{50%{box-shadow:0 0 0 10px rgba(56,185,110,0)}}
.card{background:rgba(255,255,255,.93);border:1px solid rgba(108,77,246,.11);border-radius:26px;padding:clamp(20px,3vw,34px);box-shadow:var(--shadow);backdrop-filter:blur(8px)}.center{text-align:center}.hidden{display:none!important}.subtitle{color:var(--muted);font-size:16px;line-height:1.6}.mini{font-size:13px;color:var(--muted)}
.join-card{overflow:hidden;position:relative}.join-card:after{content:"";position:absolute;width:180px;height:180px;border-radius:50%;right:-50px;top:-60px;background:linear-gradient(135deg,var(--pink),var(--yellow));opacity:.13}.hero-icon{font-size:64px;filter:drop-shadow(0 10px 12px rgba(58,47,99,.16));animation:bob 1.7s ease-in-out infinite}@keyframes bob{50%{transform:translateY(-6px)}}.join-card h2,.finish-card h2{font-size:clamp(27px,4vw,42px);margin:6px 0 8px}
.initials{display:flex;gap:12px;justify-content:center;align-items:center;margin:26px 0;flex-wrap:wrap}.initials input{width:132px;font-size:34px;letter-spacing:8px;text-align:center;text-transform:uppercase;padding:12px;border-radius:16px;border:3px solid #d9d5fa;background:#fff;outline:none;transition:.2s}.initials input:focus{border-color:var(--purple);box-shadow:0 0 0 5px rgba(108,77,246,.11)}button{border:0;border-radius:15px;padding:14px 20px;font-size:15px;font-weight:900;cursor:pointer;background:linear-gradient(135deg,var(--purple),#8d6cff);color:white;box-shadow:0 10px 25px rgba(108,77,246,.24);transition:.2s transform,.2s filter}button:hover{transform:translateY(-2px);filter:saturate(1.08)}button:disabled{opacity:.58;cursor:not-allowed;transform:none}.join-notes{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}.join-notes span,.player-chip,.question-chip{background:#f6f4ff;border:1px solid #e6e0ff;border-radius:999px;padding:8px 12px;font-size:13px;font-weight:800}
.topbar{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:20px;flex-wrap:wrap}.progress{height:13px;background:#eeeaff;border-radius:999px;overflow:hidden;flex:1;min-width:180px;border:1px solid #e3dcff}.progress>div{height:100%;background:linear-gradient(90deg,var(--purple),var(--pink),var(--yellow));width:0;transition:width .5s ease}.question{font-size:clamp(22px,3vw,31px);font-weight:850;line-height:1.27;margin:12px 0 24px;letter-spacing:-.018em}.options{display:grid;grid-template-columns:1fr 1fr;gap:14px}.option{display:flex;align-items:flex-start;gap:12px;text-align:left;padding:16px;background:#faf9ff;color:var(--ink);border:2px solid #ebe7ff;font-weight:700;min-height:82px;box-shadow:none}.option:hover{border-color:#c9bfff;background:#f6f3ff}.option .letter{display:inline-grid;place-items:center;width:32px;height:32px;border-radius:11px;background:#fff;border:2px solid #ddd6ff;color:var(--purple);flex:0 0 32px}.option.correct{background:#eaf9ef;border-color:#8ed4aa}.option.wrong{background:#ffeded;border-color:#efaaaa}.feedback{margin-top:18px;padding:15px 17px;border-radius:15px;font-weight:850}.feedback.ok{background:#e9f9ef;color:#21623c;border:1px solid #b9e6ca}.feedback.bad{background:#ffeded;color:#8a2d35;border:1px solid #f0c2c5}.action-row{margin-top:16px;text-align:right}
.race-wrap{margin-top:22px}.personal-race{background:linear-gradient(135deg,#f7f5ff,#fff8dd);border-radius:20px;padding:16px;border:1px solid #e6e0ff}.race-title{display:flex;justify-content:space-between;gap:10px;color:var(--muted);font-size:12px;font-weight:850;margin-bottom:8px}.track{position:relative;height:98px;background:linear-gradient(#535867,#414550);border:5px solid var(--track-edge);border-radius:20px;overflow:hidden;box-shadow:inset 0 0 0 2px rgba(255,255,255,.09),inset 0 -8px 12px rgba(0,0,0,.11)}.track:before,.lane-track:before{content:"";position:absolute;left:0;right:0;top:50%;height:3px;transform:translateY(-50%);background:repeating-linear-gradient(90deg,rgba(255,255,255,.85) 0 22px,transparent 22px 42px)}.track:after,.lane-track:after{content:"";position:absolute;right:22px;top:0;bottom:0;width:18px;background:conic-gradient(#fff 25%,#1f2230 0 50%,#fff 0 75%,#1f2230 0) 0/18px 18px;box-shadow:-3px 0 0 rgba(255,255,255,.65)}.track-markers{position:absolute;inset:0 52px 0 18px;display:flex;justify-content:space-between;align-items:flex-end;padding-bottom:7px;pointer-events:none}.track-marker{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.42)}
.runner{position:absolute;left:12px;top:17px;width:60px;height:60px;border-radius:20px;display:grid;place-items:center;font-size:39px;background:linear-gradient(145deg,#fff,#fff3c3);border:3px solid var(--yellow);box-shadow:0 9px 20px rgba(0,0,0,.22);transition:left .75s cubic-bezier(.22,.8,.2,1),transform .22s;z-index:3}.runner.boost{animation:boost .72s ease}@keyframes boost{30%{transform:rotate(-7deg) scale(1.1)}60%{transform:rotate(5deg) scale(1.06)}}.runner-label{position:absolute;bottom:-19px;font-size:11px;font-weight:950;color:#fff;background:#25293a;border-radius:999px;padding:2px 6px;left:50%;transform:translateX(-50%);white-space:nowrap}.finish-score{font-size:62px;font-weight:950;margin:10px 0;color:var(--purple)}
.scoreboard{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:18px;padding:16px}.scoreboard-item{display:flex;align-items:center;gap:13px;background:linear-gradient(135deg,#faf8ff,#fff);border:1px solid #ebe5ff;border-radius:19px;padding:13px 17px}.scoreboard-item>span{font-size:27px}.scoreboard-item strong{display:block;font-size:26px}.scoreboard-item small{display:block;color:var(--muted);font-weight:700}.race-stage{padding:22px}.stage-heading{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:15px}.stage-heading h2{font-size:30px;margin:2px 0 0}.legend{display:flex;gap:13px;color:var(--muted);font-size:12px;font-weight:800}.race-list{display:grid;gap:12px}.lane-card{display:grid;grid-template-columns:72px 1fr 100px;gap:14px;align-items:center;padding:10px 12px;border-radius:20px;background:linear-gradient(135deg,#fbfbff,#fffaf0);border:1px solid #ebe5ff;transition:.3s}.lane-card.leader{border-color:#ffd45f;box-shadow:0 8px 23px rgba(255,200,61,.18)}.rank-badge{width:58px;height:58px;border-radius:18px;display:grid;place-items:center;background:#f1edff;color:var(--purple);font-weight:950;font-size:20px}.rank-badge.gold{background:#fff1b8;color:#8a6100}.rank-badge.silver{background:#eef2f7;color:#596275}.rank-badge.bronze{background:#f8dfcf;color:#8a4d2c}.lane-center{min-width:0}.lane-meta{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:6px}.lane-name{display:flex;align-items:center;gap:8px;font-size:17px;font-weight:950}.score-pill{font-size:12px;font-weight:900;background:#fff;border:1px solid #e7e3f7;border-radius:999px;padding:5px 9px}.lane-track{position:relative;height:72px;background:linear-gradient(#535867,#414550);border:4px solid var(--track-edge);border-radius:16px;overflow:hidden}.lane-runner{position:absolute;left:9px;top:8px;width:48px;height:48px;border-radius:16px;display:grid;place-items:center;font-size:31px;background:linear-gradient(145deg,#fff,#fff4c6);border:2px solid var(--yellow);box-shadow:0 6px 12px rgba(0,0,0,.22);transition:left .85s cubic-bezier(.22,.8,.2,1);z-index:3}.lane-stats{text-align:center}.lane-stats strong{font-size:22px;display:block}.lane-stats small{font-size:11px;color:var(--muted);font-weight:800}.online-dot{width:9px;height:9px;border-radius:50%;background:var(--green);display:inline-block;box-shadow:0 0 0 4px rgba(56,185,110,.12)}
.podium-section{margin-top:18px}.podium{display:flex;justify-content:center;align-items:flex-end;gap:12px;min-height:190px;padding-top:18px}.podium-place{width:min(210px,29%);text-align:center}.podium-runner{font-size:37px;margin-bottom:5px}.podium-block{border-radius:20px 20px 10px 10px;padding:14px 8px 12px;font-weight:950;background:#eee9ff}.podium-place.first .podium-block{height:126px;background:linear-gradient(#ffe78a,#ffd156)}.podium-place.second .podium-block{height:99px;background:linear-gradient(#f2f5fa,#dce3ec)}.podium-place.third .podium-block{height:78px;background:linear-gradient(#f2d8c4,#ddb393)}.podium-number{font-size:27px}.podium-name{font-size:18px}.podium-score{font-size:12px;color:#5d6071;margin-top:3px}
.dashboard-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:18px}.stat{background:#fff;border-radius:20px;padding:18px;border:1px solid #e6e0ff;box-shadow:var(--shadow)}.stat.playful:nth-child(1){background:linear-gradient(135deg,#eafaff,#fff)}.stat.playful:nth-child(2){background:linear-gradient(135deg,#fff7d8,#fff)}.stat.playful:nth-child(3){background:linear-gradient(135deg,#f2edff,#fff)}.stat span{color:var(--muted);font-weight:800}.stat strong{font-size:36px;display:block;margin-top:5px}.admin-player-list{display:grid;gap:9px}.admin-player{display:grid;grid-template-columns:60px 1fr 110px 120px;gap:12px;align-items:center;padding:11px 13px;border:1px solid #eee9ff;background:#fbfaff;border-radius:15px}.admin-rank{font-weight:950;color:var(--purple)}.admin-name{font-weight:900}.admin-progress{height:9px;background:#ebe7fa;border-radius:999px;overflow:hidden}.admin-progress>i{display:block;height:100%;background:linear-gradient(90deg,var(--purple),var(--pink),var(--yellow))}
@media(max-width:820px){.options{grid-template-columns:1fr}.brand,.race-hero{flex-direction:column}.scoreboard,.dashboard-stats{grid-template-columns:1fr}.lane-card{grid-template-columns:56px 1fr}.lane-stats{grid-column:2;text-align:left;display:flex;gap:8px;align-items:center}.rank-badge{width:50px;height:50px}.admin-player{grid-template-columns:45px 1fr 70px}.admin-progress{grid-column:2/4}.legend{display:none}.podium-place{width:31%}}
@media(max-width:540px){.container{width:min(95vw,1000px);padding-top:16px}.card{border-radius:21px}.initials{align-items:stretch}.initials input{width:100%}.initials button{width:100%}.track{height:88px}.runner{width:54px;height:54px;font-size:34px}.scoreboard{grid-template-columns:1fr 1fr}.scoreboard-item:last-child{grid-column:1/-1}.lane-card{padding:8px}.lane-track{height:66px}.lane-runner{width:44px;height:44px;font-size:28px}.race-stage{padding:15px}.podium{gap:6px}.podium-name{font-size:14px}}

/* V4 — autoria, jogadores online e ordem de chegada */
.race-copyright{display:flex;justify-content:flex-end;align-items:center;margin:0 2px 10px;color:#6d6880;font-size:12px;font-weight:850;letter-spacing:.02em}
.players-now{margin-top:16px;padding:14px 15px;border:1px solid #e6e0ff;border-radius:18px;background:linear-gradient(135deg,#fbfaff,#f2fbff)}
.players-now-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px;color:#3a3560}.players-now-heading span{font-size:12px;color:var(--muted);font-weight:800}
.players-now-list{display:flex;gap:8px;flex-wrap:wrap}.player-roster-chip{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border-radius:999px;background:#fff;border:1px solid #e4defa;box-shadow:0 3px 9px rgba(58,47,99,.06)}.player-roster-chip b{font-size:13px}.player-roster-chip small{font-size:10px;color:var(--muted);font-weight:900}.player-roster-chip.me{border-color:#8f7cff;background:#f1eeff;box-shadow:0 0 0 3px rgba(108,77,246,.08)}
.arrival-section{margin-top:18px}.arrival-list{display:grid;gap:9px}.arrival-item{display:grid;grid-template-columns:54px 42px minmax(70px,1fr) auto;align-items:center;gap:9px;padding:10px 13px;border:1px solid #ebe5ff;background:linear-gradient(135deg,#fff,#fbfaff);border-radius:15px}.arrival-item.top-arrival{background:linear-gradient(135deg,#fff9df,#fff)}.arrival-rank{width:46px;height:34px;display:grid;place-items:center;border-radius:11px;background:#f0ebff;color:var(--purple);font-weight:950}.arrival-runner{font-size:24px}.arrival-score{font-size:12px;color:var(--muted);font-weight:850;white-space:nowrap}
@media(max-width:540px){.arrival-item{grid-template-columns:46px 35px 1fr}.arrival-score{grid-column:3}.race-copyright{justify-content:center;margin-bottom:7px}}
